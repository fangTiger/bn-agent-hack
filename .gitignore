# 行情缓存：全部可由 scripts/ 与 src/calibrate.py 重新拉取
data/*_1h.json
data/*_1d.json
data/*_30m.json

# 运行时产物
# 注意必须写 log/* 而非 log/：排除目录本身会让 git 不再进入该目录，
# 后面的 ! 例外规则将永远不生效
log/*
# 例外：决策与成交回执是本项目的核心证据，必须公开
!log/decision_*.json
!log/execution_*.jsonl
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# 真实账户快照，含持仓与权益，不得提交
# 注意：gitignore 不支持行尾注释，模式必须独占一行
state/

# 内部工作文档：含参赛策略分析，不公开
docs/plans/
docs/submission/
